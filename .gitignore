# Claude Code local state stays ignored; project skills under .claude/skills/ are shared.
.claude/*
!.claude/skills/

# Design specs (local working docs, not committed)
.specs/

# Sample renders / parity captures from local runs (large binaries)
generated_samples/

# Coverage artifacts
.coverage
.coverage.*
coverage.json
htmlcov/

# Neuron compiler scratch (dumped in cwd during device compiles)
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/
neuronxcc-*/
log-neuron-cc.txt

# Parallel sweep working artifacts (raw run JSONs, toolchain snapshots, control
# runs are machine-local; distilled anchors live in benchmark/trn2/flux_*.json,
# difflet/planner/data/measurements.json, and the docs/reports + docs/plans tables)
artifacts/flux_parallel_sweep/
artifacts/parallel_phase_sweep/

# nkd/neuroncc compile temp dirs leaked into CWD when compiling from repo root
/c[0-9a-f][0-9a-f][0-9a-f]*/

# Benchmark / verification media — evidence stays on the device and in the
# runner's artifacts dir; the repo keeps the JSON/MD, not the pixels.
artifacts/**/*.png
artifacts/**/*.mp4
