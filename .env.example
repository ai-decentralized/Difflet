# Optional private S3-compatible storage configuration for `difflet serve`.
# Without these values, generated images are returned as Base64 data URLs.
# Copy this file to `.env` only when enabling object-storage output.

DIFFLET_S3_BUCKET=difflet
DIFFLET_S3_REGION=ap-southeast-4
DIFFLET_S3_ENDPOINT_URL=
DIFFLET_S3_ACCESS_KEY_ID=
DIFFLET_S3_SECRET_ACCESS_KEY=
DIFFLET_S3_SESSION_TOKEN=

# Optional settings.
DIFFLET_S3_PREFIX=difflet
DIFFLET_S3_CLIENT_TIMEOUT=60
DIFFLET_S3_ADDRESSING_STYLE=

# Leave endpoint and credentials empty to use AWS S3 with the boto3 default
# credential chain (for example, an EC2 IAM role). Fill them for non-AWS
# S3-compatible providers such as Cloudflare R2 or MinIO. Session token is
# optional and is used only with temporary explicit credentials. Addressing
# style defaults to virtual for AWS and auto for explicit compatible endpoints;
# set it to path when required by the provider.
