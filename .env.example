# Cloudflare R2 configuration used by `difflet serve`.
# Copy this file to `.env` and replace placeholder values locally.

DIFFLET_R2_BUCKET=your-bucket-name
DIFFLET_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
DIFFLET_R2_ACCESS_KEY_ID=your-access-key-id
DIFFLET_R2_SECRET_ACCESS_KEY=your-secret-access-key

# Optional settings.
DIFFLET_R2_PREFIX=difflet
# Public bucket or custom-domain base URL. Leave empty to return expiring presigned URLs.
DIFFLET_R2_PUBLIC_BASE_URL=
DIFFLET_R2_CLIENT_TIMEOUT=60
