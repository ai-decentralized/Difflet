# Optional Cloudflare R2 configuration for `difflet serve`.
# Without these values, generated images are returned as Base64 data URLs.
# Copy this file to `.env` only when enabling R2 output.

DIFFLET_R2_BUCKET=your-bucket-name
DIFFLET_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
DIFFLET_R2_ACCESS_KEY_ID=your-access-key-id
DIFFLET_R2_SECRET_ACCESS_KEY=your-secret-access-key

# Optional settings.
DIFFLET_R2_PREFIX=difflet
# Optional public bucket/custom-domain mode. Configure a matching bucket lifecycle
# policy for object retention; strict URL expiry requires leaving this empty.
DIFFLET_R2_PUBLIC_BASE_URL=
DIFFLET_R2_CLIENT_TIMEOUT=60
